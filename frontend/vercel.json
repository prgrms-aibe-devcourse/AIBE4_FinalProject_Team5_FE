{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://api.coditor.xyz:8080/api/:path*"
    },
    {
      "source": "/coditor/:path*",
      "destination": "http://api.coditor.xyz:8080/coditor/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://api.coditor.xyz:8080/auth/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "http://api.coditor.xyz:8080/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "http://api.coditor.xyz:8080/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}